# Copier ce fichier en .env sur le serveur, puis remplir les deux valeurs.
# Le .env n'est jamais commité (voir .gitignore).

# Compte de service PocketBase. Créé automatiquement au premier démarrage
# par pb_migrations/1756944000_init_loup_garou.js.
# L'adresse n'a pas besoin d'exister : aucun courriel n'est envoyé.
POCKETBASE_ADMIN_EMAIL=lg@soleiljaune.be

# Mot de passe long et unique, par exemple : openssl rand -base64 30
POCKETBASE_ADMIN_PASSWORD=
